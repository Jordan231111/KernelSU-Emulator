+++ b/kernel/mumu_map_files.c
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MuMu 4.19 proc map_files coverage. The iterator below is derived from
+ * Linux fs/proc/base.c at the profile's pinned Android common revision.
+ * Filter before proc_fill_cache emits anything; both passes use the same rule.
+ */
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/mm.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/task.h>
+#include <linux/ptrace.h>
+#include <linux/flex_array.h>
+#include <linux/namei.h>
+#include "internal.h"
+#include "symbol_resolver.h"
+#include "patch_memory.h"
+
+/* Verified in MuMu Image: proc_map_files_readdir loads pid at inode - 0x48. */
+static_assert(offsetof(struct proc_inode, vfs_inode) - offsetof(struct proc_inode, pid) == 72);
+extern bool mumu_sus_map_inode_hidden(struct inode *inode);
+static const struct file_operations *mumu_ops;
+static const struct inode_operations *mumu_iops;
+static const struct dentry_operations *mumu_dops;
+static int (*original_iterate)(struct file *, struct dir_context *);
+static struct dentry *(*original_lookup)(struct inode *, struct dentry *, unsigned int);
+static int (*original_revalidate)(struct dentry *, unsigned int);
+static bool (*mumu_fill_cache)(struct file *, struct dir_context *, const char *, unsigned int,
+                              instantiate_t, struct task_struct *, const void *);
+static instantiate_t *mumu_instantiate;
+static bool iter_patched, lookup_patched, revalidate_patched;
+struct map_files_info { unsigned long start, end; fmode_t mode; };
+
+static int
+mumu_map_readdir(struct file *file, struct dir_context *ctx)
+{
+	struct vm_area_struct *vma;
+	struct task_struct *task;
+	struct mm_struct *mm;
+	unsigned long nr_files, pos, i;
+	struct flex_array *fa = NULL;
+	struct map_files_info info;
+	struct map_files_info *p;
+	int ret;
+
+	ret = -ENOENT;
+	task = get_proc_task(file_inode(file));
+	if (!task)
+		goto out;
+
+	ret = -EACCES;
+	if (!ptrace_may_access(task, PTRACE_MODE_READ_FSCREDS))
+		goto out_put_task;
+
+	ret = 0;
+	if (!dir_emit_dots(file, ctx))
+		goto out_put_task;
+
+	mm = get_task_mm(task);
+	if (!mm)
+		goto out_put_task;
+
+	ret = down_read_killable(&mm->mmap_sem);
+	if (ret) {
+		mmput(mm);
+		goto out_put_task;
+	}
+
+	nr_files = 0;
+
+	/*
+	 * We need two passes here:
+	 *
+	 *  1) Collect vmas of mapped files with mmap_sem taken
+	 *  2) Release mmap_sem and instantiate entries
+	 *
+	 * otherwise we get lockdep complained, since filldir()
+	 * routine might require mmap_sem taken in might_fault().
+	 */
+
+	for (vma = mm->mmap, pos = 2; vma; vma = vma->vm_next) {
+		if (vma->vm_file && ++pos > ctx->pos)
+			nr_files++;
+	}
+
+	if (nr_files) {
+		fa = flex_array_alloc(sizeof(info), nr_files,
+					GFP_KERNEL);
+		if (!fa || flex_array_prealloc(fa, 0, nr_files,
+						GFP_KERNEL)) {
+			ret = -ENOMEM;
+			if (fa)
+				flex_array_free(fa);
+			up_read(&mm->mmap_sem);
+			mmput(mm);
+			goto out_put_task;
+		}
+		for (i = 0, vma = mm->mmap, pos = 2; vma;
+				vma = vma->vm_next) {
+			if (!vma->vm_file || mumu_sus_map_inode_hidden(file_inode(vma->vm_file)))
+				continue;
+			if (++pos <= ctx->pos)
+				continue;
+
+			info.start = vma->vm_start;
+			info.end = vma->vm_end;
+			info.mode = vma->vm_file->f_mode;
+			if (flex_array_put(fa, i++, &info, GFP_KERNEL))
+				BUG();
+		}
+		nr_files = i;
+	}
+	up_read(&mm->mmap_sem);
+	mmput(mm);
+
+	for (i = 0; i < nr_files; i++) {
+		char buf[4 * sizeof(long) + 2];	/* max: %lx-%lx\0 */
+		unsigned int len;
+
+		p = flex_array_get(fa, i);
+		len = snprintf(buf, sizeof(buf), "%lx-%lx", p->start, p->end);
+		if (!mumu_fill_cache(file, ctx,
+				      buf, len,
+				      mumu_instantiate,
+				      task,
+				      (void *)(unsigned long)p->mode))
+			break;
+		ctx->pos++;
+	}
+	if (fa)
+		flex_array_free(fa);
+
+out_put_task:
+	put_task_struct(task);
+out:
+	return ret;
+}
+
+
+static bool mumu_map_range_hidden(struct inode *dir, const struct qstr *name)
+{
+    char text[2 * sizeof(unsigned long) * 2 + 2], *dash;
+    unsigned long start, end;
+    struct task_struct *task;
+    struct mm_struct *mm;
+    struct vm_area_struct *vma;
+    bool hidden = false;
+    if (!dir || name->len >= sizeof(text)) return false;
+    memcpy(text, name->name, name->len); text[name->len] = 0;
+    dash = strchr(text, '-');
+    if (!dash) return false;
+    *dash++ = 0;
+    if (kstrtoul(text, 16, &start) || kstrtoul(dash, 16, &end)) return false;
+    task = get_proc_task(dir);
+    if (!task) return false;
+    mm = get_task_mm(task);
+    put_task_struct(task);
+    if (!mm) return false;
+    down_read(&mm->mmap_sem);
+    vma = find_vma(mm, start);
+    if (vma && vma->vm_start == start && vma->vm_end == end && vma->vm_file)
+        hidden = mumu_sus_map_inode_hidden(file_inode(vma->vm_file));
+    up_read(&mm->mmap_sem);
+    mmput(mm);
+    return hidden;
+}
+
+static struct dentry *mumu_map_lookup(struct inode *dir, struct dentry *dentry, unsigned int flags)
+{
+    if (mumu_map_range_hidden(dir, &dentry->d_name)) return ERR_PTR(-ENOENT);
+    return original_lookup(dir, dentry, flags);
+}
+
+static int mumu_map_revalidate(struct dentry *dentry, unsigned int flags)
+{
+    if (flags & LOOKUP_RCU) return -ECHILD;
+    if (mumu_map_range_hidden(d_inode(dentry), &dentry->d_name)) return 0;
+    return original_revalidate(dentry, flags);
+}
+
+void mumu_map_files_exit(void)
+{
+    if (revalidate_patched)
+        ksu_patch_text((void *)&mumu_dops->d_revalidate, &original_revalidate,
+                       sizeof(original_revalidate), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (lookup_patched)
+        ksu_patch_text((void *)&mumu_iops->lookup, &original_lookup,
+                       sizeof(original_lookup), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (iter_patched)
+        ksu_patch_text((void *)&mumu_ops->iterate_shared, &original_iterate,
+                       sizeof(original_iterate), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    revalidate_patched = lookup_patched = iter_patched = false;
+}
+
+int mumu_map_files_init(void)
+{
+    typeof(original_iterate) iterate = mumu_map_readdir;
+    typeof(original_lookup) lookup = mumu_map_lookup;
+    typeof(original_revalidate) revalidate = mumu_map_revalidate;
+    int rc;
+    mumu_ops = (void *)find_kernel_symbol_exact("proc_map_files_operations");
+    mumu_iops = (void *)find_kernel_symbol_exact("proc_map_files_inode_operations");
+    mumu_dops = (void *)find_kernel_symbol_exact("tid_map_files_dentry_operations");
+    mumu_fill_cache = (void *)find_kernel_symbol_exact("proc_fill_cache");
+    mumu_instantiate = (void *)find_kernel_symbol_exact("proc_map_files_instantiate");
+    if (!mumu_ops || !mumu_iops || !mumu_dops || !mumu_fill_cache || !mumu_instantiate)
+        return -ENOENT;
+    original_iterate = mumu_ops->iterate_shared;
+    original_lookup = mumu_iops->lookup;
+    original_revalidate = mumu_dops->d_revalidate;
+    rc = ksu_patch_text((void *)&mumu_ops->iterate_shared, &iterate, sizeof(iterate), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (rc) return rc;
+    iter_patched = true;
+    rc = ksu_patch_text((void *)&mumu_iops->lookup, &lookup, sizeof(lookup), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (rc) goto fail;
+    lookup_patched = true;
+    rc = ksu_patch_text((void *)&mumu_dops->d_revalidate, &revalidate, sizeof(revalidate), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (rc) goto fail;
+    revalidate_patched = true;
+    return 0;
+fail:
+    mumu_map_files_exit();
+    return rc;
+}
