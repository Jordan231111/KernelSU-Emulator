+++ b/kernel/mumu_overlay.c
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* 4.19 overlay metadata and directory views, following canonical SUS_OVERLAYFS.
+ * Apply to ordinary processes KernelSU unmounts for; root keeps the real view.
+ * Use the kernel's own lower-path and credential helpers, without private structs.
+ */
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/file.h>
+#include <linux/namei.h>
+#include <linux/statfs.h>
+#include <linux/mount.h>
+#include <linux/magic.h>
+#include <linux/cred.h>
+#include <linux/kprobes.h>
+#include "ksu_umount_gate.h"
+#include "symbol_resolver.h"
+#include "patch_memory.h"
+#include "susfs_kprobe.h"
+
+static bool overlay_hide = true;
+module_param(overlay_hide, bool, 0600);
+static void (*lower_path)(struct dentry *, struct path *);
+static const struct cred *(*overlay_creds)(struct super_block *);
+static int (*real_statfs)(const struct path *, struct kstatfs *);
+static int (*real_getattr)(const struct path *, struct kstat *, u32, unsigned int);
+static int (*original_statfs)(struct dentry *, struct kstatfs *);
+static int (*original_getattr)(const struct path *, struct kstat *, u32, unsigned int);
+static int (*original_iterate)(struct file *, struct dir_context *);
+static const struct super_operations *super_ops;
+static const struct file_operations *dir_ops;
+static const struct inode_operations *inode_ops[4];
+static unsigned int patched_inodes;
+static bool patched_statfs, patched_iterate, flags_armed;
+
+static bool overlay_filter(void)
+{
+    return READ_ONCE(overlay_hide) && susfs_is_current_proc_umounted_app();
+}
+
+static int mumu_overlay_statfs(struct dentry *dentry, struct kstatfs *buf)
+{
+    struct path lower = {};
+    if (overlay_filter()) lower_path(dentry->d_sb->s_root, &lower);
+    if (lower.dentry && lower.mnt) return real_statfs(&lower, buf);
+    return original_statfs(dentry, buf);
+}
+
+static int mumu_overlay_getattr(const struct path *path, struct kstat *stat,
+                                u32 request_mask, unsigned int flags)
+{
+    struct path lower = {};
+    const struct cred *saved;
+    int rc;
+    if (overlay_filter()) lower_path(path->dentry, &lower);
+    if (!lower.dentry || !lower.mnt)
+        return original_getattr(path, stat, request_mask, flags);
+    saved = overlay_creds(path->dentry->d_sb);
+    rc = real_getattr(&lower, stat, request_mask, flags);
+    if (saved) revert_creds(saved);
+    return rc;
+}
+
+static int mumu_overlay_iterate(struct file *file, struct dir_context *ctx)
+{
+    struct path lower = {};
+    const struct cred *saved;
+    struct file *real;
+    int rc;
+    if (overlay_filter()) lower_path(file->f_path.dentry, &lower);
+    if (!lower.dentry || !lower.mnt) return original_iterate(file, ctx);
+    saved = overlay_creds(file->f_path.dentry->d_sb);
+    real = dentry_open(&lower, file->f_flags | O_NOATIME, current_cred());
+    if (saved) revert_creds(saved);
+    if (IS_ERR(real)) return PTR_ERR(real);
+    real->f_pos = ctx->pos;
+    rc = iterate_dir(real, ctx);
+    fput(real);
+    return rc;
+}
+
+/* vfs_statfs assigns mount flags after ->statfs. Preserve the actual lower
+ * mount's flags as well, rather than only changing the filesystem magic. */
+static unsigned long lower_flags(struct vfsmount *mnt)
+{
+    unsigned long flags = ST_VALID, m = mnt->mnt_flags, s = mnt->mnt_sb->s_flags;
+    if ((m & MNT_READONLY) || (s & SB_RDONLY)) flags |= ST_RDONLY;
+    if (m & MNT_NOSUID) flags |= ST_NOSUID;
+    if (m & MNT_NODEV) flags |= ST_NODEV;
+    if (m & MNT_NOEXEC) flags |= ST_NOEXEC;
+    if (m & MNT_NOATIME) flags |= ST_NOATIME;
+    if (m & MNT_NODIRATIME) flags |= ST_NODIRATIME;
+    if (m & MNT_RELATIME) flags |= ST_RELATIME;
+    if (s & SB_SYNCHRONOUS) flags |= ST_SYNCHRONOUS;
+    if (s & SB_MANDLOCK) flags |= ST_MANDLOCK;
+    return flags;
+}
+struct overlay_statfs_call { struct kstatfs *buf; unsigned long flags; };
+static int overlay_flags_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct overlay_statfs_call *call = (void *)ri->data;
+    const struct path *path = (void *)regs->regs[0];
+    struct path lower = {};
+    call->buf = NULL;
+    if (!overlay_filter() || !path || !path->dentry ||
+        path->dentry->d_sb->s_magic != OVERLAYFS_SUPER_MAGIC) return 1;
+    lower_path(path->dentry->d_sb->s_root, &lower);
+    if (!lower.mnt || !lower.dentry) return 1;
+    call->buf = (void *)regs->regs[1];
+    call->flags = lower_flags(lower.mnt);
+    return 0;
+}
+static int overlay_flags_return(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct overlay_statfs_call *call = (void *)ri->data;
+    if (call->buf && !regs->regs[0]) call->buf->f_flags = call->flags;
+    return 0;
+}
+static struct kretprobe overlay_flags_probe = {
+    .kp.symbol_name = "vfs_statfs", .entry_handler = overlay_flags_entry,
+    .handler = overlay_flags_return, .data_size = sizeof(struct overlay_statfs_call), .maxactive = 128,
+};
+static int overlay_missed_get(char *buf, const struct kernel_param *kp)
+{
+    return scnprintf(buf, PAGE_SIZE, "%d\n", overlay_flags_probe.nmissed);
+}
+static const struct kernel_param_ops overlay_missed_ops = { .get = overlay_missed_get };
+module_param_cb(overlay_missed, &overlay_missed_ops, NULL, 0400);
+
+void mumu_overlay_exit(void)
+{
+    if (flags_armed) {
+        unregister_kretprobe(&overlay_flags_probe);
+        susfs_krp_forget_addr(&overlay_flags_probe);
+        flags_armed = false;
+    }
+    if (patched_iterate) ksu_patch_text((void *)&dir_ops->iterate, &original_iterate, sizeof(original_iterate), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (patched_statfs) ksu_patch_text((void *)&super_ops->statfs, &original_statfs, sizeof(original_statfs), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    while (patched_inodes) {
+        const struct inode_operations *ops = inode_ops[--patched_inodes];
+        ksu_patch_text((void *)&ops->getattr, &original_getattr, sizeof(original_getattr), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    }
+    patched_iterate = patched_statfs = false;
+}
+
+int mumu_overlay_init(void)
+{
+    const char *names[] = {"ovl_file_inode_operations", "ovl_dir_inode_operations", "ovl_symlink_inode_operations", "ovl_special_inode_operations"};
+    typeof(original_getattr) getattr = mumu_overlay_getattr;
+    typeof(original_statfs) statfs = mumu_overlay_statfs;
+    typeof(original_iterate) iterate = mumu_overlay_iterate;
+    int rc, i;
+    lower_path = (void *)find_kernel_symbol_exact("ovl_path_lowerdata");
+    overlay_creds = (void *)find_kernel_symbol_exact("ovl_override_creds");
+    real_statfs = (void *)find_kernel_symbol_exact("vfs_statfs");
+    real_getattr = (void *)find_kernel_symbol_exact("vfs_getattr");
+    super_ops = (void *)find_kernel_symbol_exact("ovl_super_operations");
+    dir_ops = (void *)find_kernel_symbol_exact("ovl_dir_operations");
+    if (!lower_path || !overlay_creds || !real_statfs || !real_getattr || !super_ops || !dir_ops) return -ENOENT;
+    original_getattr = (void *)find_kernel_symbol_exact("ovl_getattr");
+    if (!original_getattr) return -ENOENT;
+    for (i = 0; i < ARRAY_SIZE(names); i++) {
+        inode_ops[i] = (void *)find_kernel_symbol_exact(names[i]);
+        if (!inode_ops[i] || inode_ops[i]->getattr != original_getattr) return -EINVAL;
+    }
+    original_statfs = super_ops->statfs;
+    original_iterate = dir_ops->iterate;
+    for (i = 0; i < ARRAY_SIZE(names); i++) {
+        rc = ksu_patch_text((void *)&inode_ops[i]->getattr, &getattr, sizeof(getattr), KSU_PATCH_TEXT_FLUSH_DCACHE);
+        if (rc) goto fail;
+        patched_inodes++;
+    }
+    rc = ksu_patch_text((void *)&super_ops->statfs, &statfs, sizeof(statfs), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (rc) goto fail;
+    patched_statfs = true;
+    rc = ksu_patch_text((void *)&dir_ops->iterate, &iterate, sizeof(iterate), KSU_PATCH_TEXT_FLUSH_DCACHE);
+    if (rc) goto fail;
+    patched_iterate = true;
+    rc = register_kretprobe(&overlay_flags_probe);
+    if (rc) { susfs_krp_forget_addr(&overlay_flags_probe); goto fail; }
+    flags_armed = true;
+    return 0;
+fail:
+    mumu_overlay_exit();
+    return rc;
+}
