+static bool mumu_api_child(void)
+{
+	struct task_struct *parent;
+	bool matches;
+
+	if (current_uid().val != 1000)
+		return false;
+	/* Runtime.exec can fork from a Binder thread, whose comm is not the APK
+	 * process name. The waiting parent's group leader retains that name. */
+	rcu_read_lock();
+	parent = rcu_dereference(current->real_parent);
+	matches = !strcmp(current->group_leader->comm, "pi_android.nemu") ||
+		(parent && !strcmp(parent->group_leader->comm, "pi_android.nemu"));
+	rcu_read_unlock();
+	return matches;
+}
