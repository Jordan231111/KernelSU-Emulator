on post-fs-data
    exec u:r:ksu:s0 root root -- /system/bin/sh /system/etc/ksu-mumu-policy/labels.sh

service ksu_mumu_policy_guard /system/bin/sh /system/etc/ksu-mumu-policy/guard.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:ksu:s0

on property:sys.ksu_mumu_policy.labels_ready=1 && property:sys.ksu_emulator.ready=1
    start ksu_mumu_policy_guard

on property:sys.boot_completed=1 && property:sys.ksu_mumu_policy.enforcing_ready=1
    exec_background u:r:ksu:s0 root root -- /system/bin/sh /system/etc/ksu-mumu-policy/mark-boot.sh
