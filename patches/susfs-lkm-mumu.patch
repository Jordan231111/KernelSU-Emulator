@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SUSFS 2.4 UID-filter wire contracts, ported to MuMu's syscall-table LKM.
+ * Canonical reference: simonpunk/susfs4ksu 784ac9e6, fs/susfs.c.
+ * Configuration is private: no package names or package-list contents are logged.
+ */
+#include <linux/module.h>
+#include <linux/mm.h>
+#include <linux/fs.h>
+#include <linux/cred.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/uaccess.h>
+#include <linux/bitmap.h>
+#include <linux/ctype.h>
+#include <linux/mutex.h>
+#include <linux/workqueue.h>
+#include <linux/resource.h>
+#include <linux/ioprio.h>
+#include <asm/unistd.h>
+#include <asm/ptrace.h>
+#include "susfs_fp_hook.h"
+
+#define UID_FIRST 10000
+#define UID_COUNT 10000
+#define UID_TEXT_SIZE 65535
+struct uid_request { char packages[UID_TEXT_SIZE]; int err; };
+static_assert(offsetof(struct uid_request, err) == 65536);
+struct uid_bitmap { struct rcu_head rcu; DECLARE_BITMAP(bits, UID_COUNT); };
+struct uid_filter {
+    char *packages;
+    const struct cred *cred;
+    struct uid_bitmap __rcu *bitmap;
+};
+static struct uid_filter filters[2]; /* path caller selection, priority target selection */
+static DEFINE_MUTEX(filter_lock);
+static bool filters_stopping;
+static struct timespec64 package_mtime;
+static loff_t package_size = -1;
+static void refresh_worker(struct work_struct *work);
+static DECLARE_DELAYED_WORK(refresh_work, refresh_worker);
+
+static bool valid_package(const char *name)
+{
+    const char *p;
+    size_t len = strlen(name);
+    if (!len || len > 255 || !strcmp(name, ".") || !strcmp(name, "..")) return false;
+    for (p = name; *p; p++) if (!isalnum(*p) && *p != '.' && *p != '_') return false;
+    return true;
+}
+
+/* The package manager's UID registry also handles apps without a data directory.
+ * The caller holds filter_lock and has temporarily borrowed the configuring root's credentials. */
+static char *read_packages(struct timespec64 *mtime, loff_t *size)
+{
+    struct file *file = filp_open("/data/system/packages.list", O_RDONLY | O_NOATIME, 0);
+    loff_t pos = 0;
+    char *buf;
+    ssize_t got;
+    if (IS_ERR(file)) return ERR_CAST(file);
+    *size = i_size_read(file_inode(file));
+    *mtime = file_inode(file)->i_mtime;
+    if (*size <= 0 || *size > 4 * 1024 * 1024) { filp_close(file, NULL); return ERR_PTR(-EFBIG); }
+    buf = vmalloc(*size + 1);
+    if (!buf) { filp_close(file, NULL); return ERR_PTR(-ENOMEM); }
+    got = kernel_read(file, buf, *size, &pos);
+    filp_close(file, NULL);
+    if (got < 0) { vfree(buf); return ERR_PTR(got); }
+    buf[got] = 0;
+    return buf;
+}
+
+static struct uid_bitmap *resolve_packages(const char *selection, const char *registry)
+{
+    struct uid_bitmap *result = kzalloc(sizeof(*result), GFP_KERNEL);
+    char *copy = kstrdup(selection, GFP_KERNEL), *next = copy, *name;
+    if (!result || !copy) { kfree(result); kfree(copy); return ERR_PTR(-ENOMEM); }
+    while ((name = strsep(&next, ","))) {
+        const char *line = registry;
+        size_t len;
+        name = strim(name);
+        if (!*name) continue;
+        if (!valid_package(name)) { kfree(copy); kfree(result); return ERR_PTR(-EINVAL); }
+        len = strlen(name);
+        while (line && *line) {
+            const char *end = strchr(line, '\n');
+            if (!strncmp(line, name, len) && (line[len] == ' ' || line[len] == '\t')) {
+                unsigned int uid;
+                if (sscanf(line + len, "%u", &uid) == 1 && uid >= UID_FIRST && uid < UID_FIRST + UID_COUNT)
+                    set_bit(uid - UID_FIRST, result->bits);
+                break;
+            }
+            line = end ? end + 1 : NULL;
+        }
+    }
+    kfree(copy);
+    return result;
+}
+
+static void publish_filter(struct uid_filter *filter, struct uid_bitmap *bitmap)
+{
+    struct uid_bitmap *old = rcu_dereference_protected(filter->bitmap, lockdep_is_held(&filter_lock));
+    rcu_assign_pointer(filter->bitmap, bitmap);
+    if (old) kfree_rcu(old, rcu);
+}
+
+bool mumu_uid_filters_active(void)
+{
+    return rcu_access_pointer(filters[0].bitmap) || rcu_access_pointer(filters[1].bitmap);
+}
+
+bool mumu_path_uid_selected(uid_t uid)
+{
+    struct uid_bitmap *bitmap;
+    bool selected;
+    if (uid >= 90000) return true;
+    rcu_read_lock();
+    bitmap = rcu_dereference(filters[0].bitmap);
+    /* Preserve the established v2.3 all-app behavior until explicitly configured. */
+    selected = !bitmap || (uid >= UID_FIRST && uid < UID_FIRST + UID_COUNT && test_bit(uid - UID_FIRST, bitmap->bits));
+    rcu_read_unlock();
+    return selected;
+}
+
+static bool priority_uid_hidden(uid_t uid)
+{
+    struct uid_bitmap *bitmap;
+    bool hidden = false;
+    uid %= 100000;
+    if (uid < UID_FIRST || uid >= UID_FIRST + UID_COUNT) return false;
+    rcu_read_lock();
+    bitmap = rcu_dereference(filters[1].bitmap);
+    if (bitmap) hidden = test_bit(uid - UID_FIRST, bitmap->bits);
+    rcu_read_unlock();
+    return hidden;
+}
+
+void mumu_uid_refresh(void)
+{
+    struct timespec64 mtime;
+    loff_t size;
+    const struct cred *saved, *cred;
+    char *registry;
+    int i;
+    if (!mumu_uid_filters_active()) return;
+    mutex_lock(&filter_lock);
+    cred = filters[0].cred ? filters[0].cred : filters[1].cred;
+    if (filters_stopping || !cred) goto out;
+    saved = override_creds(cred);
+    registry = read_packages(&mtime, &size);
+    revert_creds(saved);
+    if (IS_ERR(registry)) goto out;
+    if (size == package_size && timespec64_equal(&mtime, &package_mtime)) { vfree(registry); goto out; }
+    for (i = 0; i < ARRAY_SIZE(filters); i++) {
+        struct uid_bitmap *bitmap;
+        if (!filters[i].packages) continue;
+        bitmap = resolve_packages(filters[i].packages, registry);
+        if (IS_ERR(bitmap)) { vfree(registry); goto out; }
+        publish_filter(&filters[i], bitmap);
+    }
+    package_mtime = mtime; package_size = size;
+    vfree(registry);
+out:
+    mutex_unlock(&filter_lock);
+}
+
+static void refresh_worker(struct work_struct *work)
+{
+    mumu_uid_refresh();
+    if (!READ_ONCE(filters_stopping) && mumu_uid_filters_active()) schedule_delayed_work(&refresh_work, 5 * HZ);
+}
+
+void mumu_uid_filter_supercall(unsigned int command, void __user **arg)
+{
+    struct uid_request *request = kvzalloc(sizeof(*request), GFP_KERNEL);
+    struct uid_filter *filter = &filters[command == 0x60030];
+    struct uid_bitmap *bitmap = NULL;
+    struct timespec64 mtime;
+    loff_t size;
+    char *registry = NULL, *selection = NULL;
+    int err = -ENOMEM;
+    if (!request) goto answer;
+    if (copy_from_user(request, *arg, sizeof(*request))) { err = -EFAULT; goto answer; }
+    if (!memchr(request->packages, 0, sizeof(request->packages)) || !request->packages[0]) { err = -EINVAL; goto answer; }
+    selection = kstrdup(request->packages, GFP_KERNEL);
+    if (!selection) goto answer;
+    mutex_lock(&filter_lock);
+    if (filters_stopping) { err = -ESHUTDOWN; goto unlock; }
+    registry = read_packages(&mtime, &size);
+    if (IS_ERR(registry)) { err = PTR_ERR(registry); registry = NULL; goto unlock; }
+    bitmap = resolve_packages(selection, registry);
+    if (IS_ERR(bitmap)) { err = PTR_ERR(bitmap); goto unlock; }
+    publish_filter(filter, bitmap);
+    kfree(filter->packages); filter->packages = selection; selection = NULL;
+    if (filter->cred) put_cred(filter->cred);
+    filter->cred = get_current_cred();
+    package_size = -1; /* Refresh both selections after a registry change. */
+    schedule_delayed_work(&refresh_work, 5 * HZ);
+    err = 0;
+unlock:
+    mutex_unlock(&filter_lock);
+answer:
+    if (copy_to_user((char __user *)*arg + offsetof(struct uid_request, err), &err, sizeof(err)))
+        pr_warn_ratelimited("susfs: UID-filter error writeback failed\n");
+    vfree(registry); kfree(selection); kvfree(request);
+}
+
+static bool deny_priority(const struct pt_regs *regs, bool io)
+{
+    int which = (int)regs->regs[0], who = (int)regs->regs[1];
+    uid_t caller = current_uid().val;
+    if (caller < UID_FIRST || who <= 0 || which != (io ? IOPRIO_WHO_USER : PRIO_USER)) return false;
+    if (!io && (uid_t)who == caller) return false;
+    return priority_uid_hidden(make_kuid(current_user_ns(), who).val);
+}
+static susfs_syscall_fn_t old_getpriority, old_setpriority, old_ioprio_get, old_ioprio_set;
+#define PRIORITY_WRAP(name, io) \
+static long name##_wrap(const struct pt_regs *regs) { \
+    return deny_priority(regs, io) ? -ESRCH : old_##name(regs); \
+}
+PRIORITY_WRAP(getpriority, false)
+PRIORITY_WRAP(setpriority, false)
+PRIORITY_WRAP(ioprio_get, true)
+PRIORITY_WRAP(ioprio_set, true)
+#define PRIORITY_HOOK(fn) { .nr = __NR_##fn, .name = "mumu/" #fn, \
+    .sym = "__arm64_sys_" #fn, .wrapper = fn##_wrap, .orig_slot = &old_##fn }
+static struct susfs_fp_hook hooks[] = {
+    PRIORITY_HOOK(getpriority), PRIORITY_HOOK(setpriority), PRIORITY_HOOK(ioprio_get), PRIORITY_HOOK(ioprio_set),
+};
+void mumu_uid_filter_exit(void)
+{
+    int i;
+    WRITE_ONCE(filters_stopping, true);
+    cancel_delayed_work_sync(&refresh_work);
+    for (i = ARRAY_SIZE(hooks) - 1; i >= 0; i--) susfs_fp_remove(&hooks[i]);
+    susfs_fp_drain();
+    mutex_lock(&filter_lock);
+    for (i = 0; i < ARRAY_SIZE(filters); i++) {
+        publish_filter(&filters[i], NULL);
+        kfree(filters[i].packages); filters[i].packages = NULL;
+        if (filters[i].cred) put_cred(filters[i].cred);
+        filters[i].cred = NULL;
+    }
+    mutex_unlock(&filter_lock);
+}
+int mumu_uid_filter_init(void)
+{
+    int i, rc;
+    for (i = 0; i < ARRAY_SIZE(hooks); i++) {
+        rc = susfs_fp_install(&hooks[i]);
+        if (rc) { mumu_uid_filter_exit(); return rc; }
+    }
+    return 0;
+}
