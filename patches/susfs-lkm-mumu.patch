+struct mumu_symbols { const char *name; unsigned long *out; int count, max; };
+static int mumu_collect(void *data, const char *name, struct module *mod, unsigned long addr)
+{
+    struct mumu_symbols *s = data;
+    int i;
+    if (mod || strcmp(name, s->name)) return 0;
+    for (i = 0; i < s->count; i++) if (s->out[i] == addr) return 0;
+    s->out[s->count++] = addr;
+    return s->count == s->max;
+}
+int ksu_find_symbol_all(const char *name, unsigned long *addrs, int max)
+{
+    struct mumu_symbols s = { .name = name, .out = addrs, .max = max };
+    if (!name || !*name || !addrs || max <= 0) return 0;
+    kallsyms_on_each_symbol(mumu_collect, &s);
+    return s.count;
