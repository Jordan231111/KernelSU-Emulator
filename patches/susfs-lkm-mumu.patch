+    if (!addr || !kallsyms_lookup(addr, NULL, NULL, &mod, buf)) return -ENOENT;
+    if (module_out) *module_out = mod;
+    return strlen(buf);
+}
+int ksu_addr_is_named(unsigned long addr, const char *name)
+{
+    unsigned long addrs[8];
+    int i, n = ksu_find_symbol_all(name, addrs, ARRAY_SIZE(addrs));
+    for (i = 0; i < n; i++) if (addrs[i] == addr) return 1;
+    return 0;
+}
+int ksu_symbol_is_start(unsigned long addr, const char *name)
+{
+    char buf[KSYM_SYMBOL_LEN], *mod = NULL;
+    unsigned long offset = 0;
+    size_t len;
+    if (!addr || !name || !*name ||
+        !kallsyms_lookup(addr, NULL, &offset, &mod, buf) || mod || offset) return 0;
+    len = strlen(name);
+    return !strncmp(buf, name, len) &&
+        (!buf[len] || buf[len] == '.' || buf[len] == '$') &&
+        !strstr(buf + len, ".cfi_jt");
+}
+void *ksu_resolve_symbol_for_functable_hook(const char *name)
+{
+    /* MuMu is a non-CFI GCC kernel. Keep exact matches and reject module aliases. */
+    return (void *)find_kernel_symbol_exact(name);
+}
+int ksu_init_symbol_resolver(void)
+{
+    return find_kernel_symbol_exact("sys_call_table") &&
+        find_kernel_symbol_exact("security_hook_heads") ? 0 : -ENODATA;
+}
