# Trusted graphics/media clients need the complete MuMu buffer interface, even
# when their first allocation occurs after boot. Keep the actual driver ioctl
# range; these grants do not apply to arbitrary devices or app-private files.
allow { init surfaceflinger system_server audioserver cameraserver mediaextractor mediaserver mediaswcodec mediacodec hal_graphics_allocator_default hal_camera_default hal_sensors_default hal_audio_default hal_gnss_default } mumu_runtime_config_file file { read open getattr map }
allow { init surfaceflinger system_server audioserver cameraserver mediaextractor mediaserver mediaswcodec mediacodec hal_graphics_allocator_default hal_camera_default hal_sensors_default hal_audio_default hal_gnss_default } mumu_vaddress_device chr_file { open read write getattr ioctl map }
allowxperm { init surfaceflinger system_server audioserver cameraserver mediaextractor mediaserver mediaswcodec mediacodec hal_graphics_allocator_default hal_camera_default hal_sensors_default hal_audio_default hal_gnss_default } mumu_vaddress_device chr_file ioctl { 0x4c15-0x4c1a }
# nemuinput runs in init's domain; /dev/uinput has MuMu's uhid_device label.
# Include creation/reconfiguration, not just writes through descriptors opened
# during permissive early boot. 0x55 is the kernel's uinput ioctl family.
allow init uhid_device chr_file { open read write getattr ioctl }
allowxperm init uhid_device chr_file ioctl { 0x5500-0x55ff }
# MuMu's crash reporter reads the same configuration while unwinding a process.
allow crash_dump mumu_runtime_config_file file { read open getattr }
# nemu_sys_opt samples these pressure counters in its existing init domain.
allow init proc_pressure_cpu file { read open getattr }
allow init proc_pressure_io file { read open getattr }
# The same trusted helper controls MuMu's compact_memory/pagecache tunables,
# which this vendor policy labels proc. No application domain receives this.
allow init proc file { read open getattr write }
# Standard Binder service-manager interaction for native MuMu helpers in init.
allow init servicemanager binder { call transfer }
allow servicemanager init dir search
allow servicemanager init file { read open }
allow servicemanager init process getattr
# Service handles and callbacks travel back to MuMu's native clients as well.
allow servicemanager init binder { call transfer }
allow init init binder { call transfer }
# nemuinit discovers the emulated network interfaces through sysfs.
allow init sysfs dir { search read open getattr }
allow init sysfs file { read open getattr }
# MuMu enables devtmpfs; runtime uinput hotplug creates nodes in kdevtmpfs.
allow kernel kernel capability mknod
