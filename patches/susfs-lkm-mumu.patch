+    if (!list_empty(&m->mnt_mounts))
+        return list_first_entry(&m->mnt_mounts, struct mount, mnt_child);
+    while (m != root) {
+        if (m->mnt_child.next != &m->mnt_parent->mnt_mounts)
+            return list_entry(m->mnt_child.next, struct mount, mnt_child);
+        m = m->mnt_parent;
+    }
