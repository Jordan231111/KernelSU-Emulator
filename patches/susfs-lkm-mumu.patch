+unsigned long find_kernel_symbol_exact_any(const char *name)
+{
+    return name && *name ? kallsyms_lookup_name(name) : 0;
+}
+unsigned long ksu_kallsyms_lookup_name(const char *name)
+{
+    return find_kernel_symbol_exact_any(name);
+}
+unsigned long find_kernel_symbol_exact(const char *name)
+{
+    unsigned long addr = find_kernel_symbol_exact_any(name);
+    char buf[KSYM_SYMBOL_LEN], *mod = NULL;
+    if (!addr || !kallsyms_lookup(addr, NULL, NULL, &mod, buf) || mod)
+        return 0;
+    return addr;
